Código para obtener precios de criptomonedas


import requests

 URL de la API CoinGecko
url = "https://api.coingecko.com/api/v3/simple/price"
params = {
    "ids": "bitcoin,ethereum",  # Criptomonedas que deseas consultar
    "vs_currencies": "usd"  # Moneda de comparación
}

 Realizar la solicitud GET
response = requests.get(url, params=params)

 Comprobar el estado de la respuesta
if response.status_code == 200:
    data = response.json()
    bitcoin_price = data['bitcoin']['usd']
    ethereum_price = data['ethereum']['usd']
    print(f"Precio de Bitcoin: ${bitcoin_price}")
    print(f"Precio de Ethereum: ${ethereum_price}")
else:
    print("Error al obtener los datos")


